<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../displayTools/baseStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="linstezh.ui.controllers.ImageDistractorController"
            fx:id="contentArea" styleClass="contentArea" userData="fillParent">

    <VBox fx:id="contentVBox" styleClass="contentVBox" userData="fillParent">
        <ImageView fx:id="distractorImage" preserveRatio="true" />
        <Button onAction="#nextScene" text="next" />
    </VBox>

</AnchorPane>
