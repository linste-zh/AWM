<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../displayTools/baseStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="linstezh.ui.controllers.ExperimentStartController"
            fx:id="contentArea" styleClass="contentArea" userData="fillParent">

    <VBox fx:id="contentVBox" styleClass="contentVBox" userData="fillParent">
        <Label fx:id="title" styleClass="contentTitle"/>
        <Label fx:id="infoText" styleClass="textBox"/>
        <HBox alignment="CENTER">
            <Label text="Participant Name or ID: "/>
            <TextField fx:id="nameInput"/>
        </HBox>
        <RadioButton fx:id="consentButton" text="I consent to participating in this study" />
        <Button styleClass="actionButton" onAction="#start" text="Start" />
    </VBox>

</AnchorPane>
