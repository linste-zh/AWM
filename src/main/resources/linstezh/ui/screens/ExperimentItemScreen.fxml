<?import javafx.scene.layout.BorderPane?>

<?import javafx.scene.layout.AnchorPane?>
<AnchorPane stylesheets="@../css/baseStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="linstezh.ui.controllers.ExperimentItemController">

    <VBox spacing="20" alignment="CENTER">
        <Label fx:id="evalText"/>
