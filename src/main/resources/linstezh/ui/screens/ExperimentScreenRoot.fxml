<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../css/baseStyle.css" xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="linstezh.ui.controllers.RootController"
            fx:id="root">
    <top>
        <fx:include fx:id="header" source="Header.fxml"/>
    </top>
    <center>
        <StackPane fx:id="mainArea"/>
    </center>
    <bottom>
        <fx:include fx:id="footer" source="Footer.fxml"/>
    </bottom>
</BorderPane>
