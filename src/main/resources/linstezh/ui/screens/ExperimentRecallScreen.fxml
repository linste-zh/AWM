<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>



<BorderPane stylesheets="@../css/baseStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="linstezh.ui.controllers.ExperimentRecallController">
    <top>
        <fx:include source="Header.fxml"/>
    </top>
    <center>
        <VBox spacing="20" alignment="CENTER">
            <GridPane fx:id="grid" vgap="5" hgap="5"/>
            <Button text="Submit" onAction="#submitMemoryChunks"/>
        </VBox>
    </center>
    <bottom>
        <fx:include source="Footer.fxml"/>
    </bottom>
</BorderPane>