<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>


<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="linstezh.ui.controllers.FooterController"
            fx:id="contentArea" styleClass="footerPane" userData="fillParent">
   <HBox alignment="CENTER_LEFT" spacing="10.0" userData="fillParent">
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
      </padding>
      <Label text="Progress: "/>
      <Label fx:id="progress"/>
   </HBox>
</AnchorPane>
