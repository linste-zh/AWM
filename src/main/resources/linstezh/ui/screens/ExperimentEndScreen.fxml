<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane stylesheets="@../css/baseStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="linstezh.ui.controllers.ExperimentEndController">

    <VBox alignment="CENTER" prefHeight="66.0" prefWidth="600.0" spacing="20">
        <Label style="-fx-font-size: 25; -fx-alignment: center" text="Thank you for participating" />
        <Label fx:id="infoText" />
        <Button onAction="#downloadItemFile" text="Results by Item" />
        <Button onAction="#downloadFAggregatedFile" text="Results by Section" />
        <Button onAction="#endExperiment" text="End Experiment" />
    </VBox>

</AnchorPane>