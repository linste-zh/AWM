<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="contentArea" styleClass="contentArea" stylesheets="@../displayTools/baseStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="linstezh.ui.controllers.TrialMemoController">
    <properties fillParent="true" />

    <VBox fx:id="contentVBox" styleClass="contentVBox" alignment="CENTER">
        <properties fillParent="true"/>

        <TextArea fx:id="evalText" styleClass="textBox"
                  wrapText="true" editable="false"
                  text="Example Info Example Info Example Info Example Info Example Info Example Info Example Info">
            <properties widthPercent="1.0" maxHeightPercent="0.8"/>
        </TextArea>

        <Label alignment="CENTER" text="Is this grammatically correct?">
            <properties widthPercent="1.0" />
        </Label>

        <HBox alignment="CENTER" spacing="30.0">
            <Button onAction="#clickTrue" text="True" styleClass="actionButton"/>
            <Button onAction="#clickFalse" text="False" styleClass="actionButton"/>
        </HBox>
    </VBox>

</VBox>
